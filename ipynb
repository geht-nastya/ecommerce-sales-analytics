      "source": [
        "con.execute(\"\"\"\n",
        "CREATE OR REPLACE TABLE sales_typed AS\n",
        "SELECT\n",
        "    TRIM(InvoiceNo) AS InvoiceNo,\n",
        "    TRIM(StockCode) AS StockCode,\n",
        "    NULLIF(TRIM(Description), '') AS Description,\n",
        "    TRY_CAST(Quantity AS INTEGER) AS Quantity,\n",
        "\n",
        "    TIMESTAMP '1899-12-30 00:00:00'\n",
        "        + TRY_CAST(InvoiceDate AS DOUBLE) * INTERVAL 1 DAY\n",
        "        AS InvoiceDate,\n",
        "\n",
        "    TRY_CAST(UnitPrice AS DOUBLE) AS UnitPrice,\n",
        "    TRY_CAST(NULLIF(TRIM(CustomerID), '') AS BIGINT) AS CustomerID,\n",
        "    TRIM(Country) AS Country\n",
        "\n",
        "FROM sales;\n",
        "\"\"\")\n",
        "\n",
        "con.execute(\"DESCRIBE sales_typed;\").df()"
      ],
